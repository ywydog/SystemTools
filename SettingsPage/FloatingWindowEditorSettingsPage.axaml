<ci:SettingsPageBase x:Class="SystemTools.FloatingWindowEditorSettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     xmlns:controls1="clr-namespace:SystemTools.Controls"
                     xmlns:ruleset="clr-namespace:ClassIsland.Core.Controls.Ruleset;assembly=ClassIsland.Core"
                     xmlns:behaviors="clr-namespace:ClassIsland.Core.Behaviors;assembly=ClassIsland.Core"
                     xmlns:avaloniaXaml="using:Avalonia.Xaml.Interactivity"
                     mc:Ignorable="d"
                     d:DesignHeight="800"
                     d:DesignWidth="800">

    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">
            <Label FontSize="20"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                SystemTools
            </Label>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <ci:FluentIcon FontSize="56"
                               Glyph="&#xEFBF;"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                <Label VerticalAlignment="Center" FontSize="28">设置 · 悬浮窗</Label>
            </StackPanel>

            <!-- 方案管理 + 显示开关（紧凑顶部栏） -->
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <ci:Field Grid.Column="0" Label="配置方案">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox ItemsSource="{Binding ViewModel.FloatingWindowProfileNames}"
                                  SelectedItem="{Binding ViewModel.SelectedFloatingWindowProfile, Mode=TwoWay}"
                                  SelectionChanged="OnFloatingWindowProfileSelectionChanged"
                                  MinWidth="150"
                                  MaxWidth="250" />
                        <Button Content="{ci:FluentIcon &#xE8AB;}"
                                ToolTip.Tip="切换"
                                Click="OnToggleFloatingWindowProfileClick"
                                Theme="{StaticResource TransparentButton}" />
                        <Button Content="{ci:FluentIcon &#xE00D;}"
                                ToolTip.Tip="新建"
                                Click="OnAddFloatingWindowProfileClick"
                                Theme="{StaticResource TransparentButton}" />
                        <Button Content="{ci:FluentIcon &#xE61D;}"
                                ToolTip.Tip="删除当前方案"
                                Click="OnRemoveCurrentProfileClick"
                                Theme="{StaticResource TransparentButton}" />
                    </StackPanel>
                </ci:Field>
                <ToggleSwitch Grid.Column="1"
                              OnContent="显示" OffContent="隐藏"
                              IsChecked="{Binding ViewModel.CurrentFloatingWindowProfile.ShowFloatingWindow, Mode=OneWay}"
                              IsEnabled="{Binding ViewModel.HasFloatingTriggerEntries}"
                              IsCheckedChanged="OnFloatingWindowVisibleToggleChanged" />
            </Grid>

            <!-- ===== 按钮布局区域（ClassIsland 组件库风格） ===== -->
            <TextBlock Text="以下按钮将显示在悬浮窗上。拖拽按钮调整顺序，从组件库拖拽添加新按钮。"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="12"
                       Margin="0,4,0,4"
                       TextWrapping="Wrap" />

            <!-- 行列表区域 -->
            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4"
                    MinHeight="80">
                <Grid RowDefinitions="*,Auto">
                    <!-- 空状态：没有行时显示引导 -->
                    <StackPanel Grid.Row="0" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding !ViewModel.FloatingTriggerRows.Count}">
                        <ci:FluentIcon Glyph="&#xE9D5;"
                                       FontSize="32"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center" />
                        <TextBlock Text="还没有配置任何按钮"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="14" />
                        <TextBlock Text="从下方组件库拖拽按钮到此处，或点击按钮直接添加"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </StackPanel>

                    <!-- 行列表（ListBox，支持拖拽排序） -->
                    <ListBox Grid.Row="0"
                             x:Name="ListBoxRows"
                             ItemsSource="{Binding ViewModel.FloatingTriggerRows}"
                             SelectedItem="{Binding ViewModel.SelectedFloatingTriggerRow, Mode=TwoWay}"
                             IsVisible="{Binding ViewModel.FloatingTriggerRows.Count}"
                             Background="Transparent"
                             Margin="-4"
                             SelectionChanged="OnRowSelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="40">
                                    <!-- 行拖拽把手 -->
                                    <ci:TouchDragThumb Grid.Column="0"
                                                       Width="20"
                                                       IsExplicitVisible="True"
                                                       IsCompact="True"
                                                       VerticalAlignment="Center" />

                                    <!-- 行内按钮列表（水平 ListBox） -->
                                    <ListBox Grid.Column="1"
                                             ItemsSource="{Binding Buttons}"
                                             SelectedItem="{Binding $parent[ListBoxItem].(ListBox.SelectedItem), RelativeSource={RelativeSource AncestorType=ListBox}, Mode=OneWayToSource}"
                                             x:Name="InnerButtonListBox"
                                             Background="Transparent"
                                             SelectionChanged="OnButtonSelectionChanged">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="2" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <ci:TouchDragThumb Margin="-4,0,-2,0" IsCompact="True" VerticalAlignment="Center" />
                                                    <controls:IconSourceElement IconSource="{Binding IconSource}"
                                                                                Width="16" Height="16"
                                                                                VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ButtonName}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center" />
                                                    <Button Content="{ci:FluentIcon &#xE61D;}"
                                                            FontSize="10"
                                                            Padding="2,0"
                                                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                            Theme="{StaticResource TransparentButton}"
                                                            ToolTip.Tip="移除"
                                                            Click="OnRemoveTriggerFromRowClick"
                                                            Tag="{Binding ButtonId}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerTheme>
                                            <ControlTheme TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="4,2" />
                                                <Setter Property="Background"
                                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                <Setter Property="CornerRadius" Value="4" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                            </ControlTheme>
                                        </ListBox.ItemContainerTheme>
                                        <!-- 行内按钮拖拽行为 -->
                                        <avaloniaXaml:Interaction.Behaviors>
                                            <BehaviorCollection>
                                                <behaviors:ManagedContextDropBehavior
                                                    OverClass="TargetHighlight"
                                                    Handler="{Binding $parent[FloatingWindowEditorSettingsPage].DropHandler}"
                                                    Context="{Binding Buttons}" />
                                            </BehaviorCollection>
                                        </avaloniaXaml:Interaction.Behaviors>
                                    </ListBox>

                                    <!-- 行操作按钮 -->
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="2"
                                                VerticalAlignment="Center"
                                                Margin="4,0,0,0">
                                        <Button Content="{ci:FluentIcon &#xE00D;}"
                                                FontSize="10"
                                                Padding="4,0"
                                                ToolTip.Tip="在下方插入一行"
                                                Click="OnInsertRowBelowClick"
                                                Theme="{StaticResource TransparentButton}" />
                                        <Button Content="{ci:FluentIcon &#xE61D;}"
                                                FontSize="10"
                                                Padding="4,0"
                                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                ToolTip.Tip="删除行"
                                                Click="OnRemoveFloatingTriggerRowClick"
                                                Theme="{StaticResource TransparentButton}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerTheme>
                            <ControlTheme TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,2" />
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <!-- 行内按钮拖拽行为附加到 ListBoxItem -->
                                <Setter Property="(avaloniaXaml:Interaction.Behaviors)">
                                    <BehaviorCollectionTemplate>
                                        <BehaviorCollection>
                                            <behaviors:AdvancedManagedContextDragBehavior
                                                HorizontalDragThreshold="3"
                                                VerticalDragThreshold="3"
                                                PreviewOpacity="0.5"
                                                CanDragWithoutDragThumb="True">
                                                <behaviors:AdvancedManagedContextDragBehavior.Context>
                                                    <FloatingWindowButtonDragData
                                                        Item="{Binding}"
                                                        SourceCollection="{Binding $parent[ListBoxItem].(ListBox.ItemsSource), RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                                </behaviors:AdvancedManagedContextDragBehavior.Context>
                                            </behaviors:AdvancedManagedContextDragBehavior>
                                            <behaviors:ManagedContextDropBehavior
                                                OverClass="TargetHighlight"
                                                Handler="{Binding $parent[FloatingWindowEditorSettingsPage].DropHandler}"
                                                Context="{Binding Buttons}" />
                                        </BehaviorCollection>
                                    </BehaviorCollectionTemplate>
                                </Setter>
                            </ControlTheme>
                        </ListBox.ItemContainerTheme>
                        <!-- 行列表拖拽行为 -->
                        <avaloniaXaml:Interaction.Behaviors>
                            <BehaviorCollection>
                                <behaviors:ManagedContextDropBehavior
                                    OverClass="TargetHighlight"
                                    Handler="{Binding $parent[FloatingWindowEditorSettingsPage].DropHandler}"
                                    Context="{Binding ViewModel.FloatingTriggerRows}" />
                            </BehaviorCollection>
                        </avaloniaXaml:Interaction.Behaviors>
                    </ListBox>

                    <!-- 添加行按钮 -->
                    <Button Grid.Row="1"
                            Content="{ci:FluentIcon &#xE00D;}"
                            HorizontalAlignment="Center"
                            Click="OnAddFloatingTriggerRowClick"
                            Theme="{StaticResource TransparentButton}"
                            ToolTip.Tip="添加新行"
                            Margin="0,4,0,0" />
                </Grid>
            </Border>

            <!-- GridSplitter -->
            <GridSplitter Height="4"
                          Background="Transparent"
                          Margin="0,2" />

            <!-- TabControl 设置面板 -->
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE9D5;}"
                                       Header="组件库与设置"
                                       IsExpanded="True"
                                       Margin="0,4,0,0">
                <TabControl Margin="-12,4,-12,-12" Padding="0">

                    <!-- Tab 1: 组件库 -->
                    <TabItem Header="组件库">
                        <ListBox ItemsSource="{Binding ViewModel.AvailableFloatingTriggerItems}"
                                 x:Name="ListBoxAvailableItems"
                                 Background="Transparent"
                                 Margin="-4"
                                 SelectionChanged="OnAvailableItemSelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,4" MinHeight="40">
                                        <ci:TouchDragThumb Grid.Column="0" Width="20" VerticalAlignment="Center" />
                                        <controls:IconSourceElement Grid.Column="1"
                                                                    IconSource="{Binding IconSource}"
                                                                    Width="20" Height="20"
                                                                    VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding ButtonName}" FontSize="12" />
                                            <TextBlock Text="拖拽或点击添加"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerTheme>
                                <ControlTheme TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter Property="CornerRadius" Value="6" />
                                    <Setter Property="MinWidth" Value="140" />
                                    <Setter Property="MaxWidth" Value="200" />
                                    <Setter Property="Margin" Value="2" />
                                    <!-- 组件库项拖拽行为 -->
                                    <Setter Property="(avaloniaXaml:Interaction.Behaviors)">
                                        <BehaviorCollectionTemplate>
                                            <BehaviorCollection>
                                                <behaviors:AdvancedManagedContextDragBehavior
                                                    HorizontalDragThreshold="3"
                                                    VerticalDragThreshold="3"
                                                    PreviewOpacity="0.5"
                                                    CanDragWithoutDragThumb="True">
                                                </behaviors:AdvancedManagedContextDragBehavior>
                                            </BehaviorCollection>
                                        </BehaviorCollectionTemplate>
                                    </Setter>
                                </ControlTheme>
                            </ListBox.ItemContainerTheme>
                        </ListBox>
                        <!-- 空状态 -->
                        <TabControl.AlternateContent>
                            <!-- 不使用，空状态在 ListBox 内处理 -->
                        </TabControl.AlternateContent>
                    </TabItem>

                    <!-- Tab 2: 按钮设置 -->
                    <TabItem Header="按钮设置"
                             IsEnabled="{Binding ViewModel.SelectedFloatingTriggerItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="8" Margin="8">
                            <TextBlock Text="{Binding ViewModel.SelectedFloatingTriggerItem.ButtonName, StringFormat='{}{0} 规则集'}"
                                       FontWeight="SemiBold"
                                       IsVisible="{Binding ViewModel.SelectedFloatingTriggerItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="满足规则时隐藏"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding ViewModel.SelectedFloatingTriggerItem.Config.HideOnRule, Mode=TwoWay}" />
                            </Grid>
                            <ruleset:RulesetControl Ruleset="{Binding ViewModel.SelectedFloatingTriggerItem.Config.HidingRules}"
                                                    ShowTitle="False"
                                                    IsEnabled="{Binding ViewModel.SelectedFloatingTriggerItem.Config.HideOnRule}" />
                        </StackPanel>
                    </TabItem>

                    <!-- Tab 3: 行设置 -->
                    <TabItem Header="行设置"
                             IsEnabled="{Binding ViewModel.SelectedFloatingTriggerRow, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="8" Margin="8">
                            <TextBlock Text="{Binding ViewModel.SelectedFloatingTriggerRow.RowIndex, StringFormat='第 {0} 行规则集'}"
                                       FontWeight="SemiBold"
                                       IsVisible="{Binding ViewModel.SelectedFloatingTriggerRow, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="行可见性"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1"
                                              OnContent="显示" OffContent="隐藏"
                                              IsChecked="{Binding ViewModel.SelectedFloatingTriggerRow.RowRuleset.IsVisible, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="满足规则时隐藏"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding ViewModel.SelectedFloatingTriggerRow.RowRuleset.HideOnRule, Mode=TwoWay}" />
                            </Grid>
                            <ruleset:RulesetControl Ruleset="{Binding ViewModel.SelectedFloatingTriggerRow.RowRuleset.HidingRules}"
                                                    ShowTitle="False"
                                                    IsEnabled="{Binding ViewModel.SelectedFloatingTriggerRow.RowRuleset.HideOnRule}" />
                        </StackPanel>
                    </TabItem>

                </TabControl>
            </controls:SettingsExpander>

            <!-- 外观设置 -->
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE51E;}"
                                       Header="外观设置"
                                       Description="设置悬浮窗外观"
                                       IsExpanded="False">

                <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource &#xE10B;}"
                                               Content="悬浮窗缩放"
                                               Description="调整悬浮窗缩放大小">
                    <controls:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Slider Width="160"
                                    Minimum="0.5"
                                    Maximum="2"
                                    TickFrequency="0.1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowScale, Mode=TwoWay}" />
                            <TextBlock
                                Text="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowScale, StringFormat='{}{0:F1}x'}"
                                Width="46"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>

                <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource &#xE721;}"
                                               Content="图标大小"
                                               Description="调整悬浮窗内图标缩放">
                    <controls:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Slider Width="160"
                                    Minimum="15"
                                    Maximum="50"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowIconSize, Mode=TwoWay}" />
                            <TextBlock
                                Text="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowIconSize, StringFormat='{}{0}px'}"
                                Width="46"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>

                <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource &#xF26F;}"
                                               Content="文字大小"
                                               Description="调整悬浮窗内文字缩放">
                    <controls:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Slider Width="160"
                                    Minimum="8"
                                    Maximum="25"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowTextSize, Mode=TwoWay}" />
                            <TextBlock
                                Text="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowTextSize, StringFormat='{}{0}px'}"
                                Width="46"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>

                <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource &#xE772;}"
                                               Content="透明度"
                                               Description="调整悬浮窗透明度">
                    <controls:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Slider Width="160"
                                    Minimum="10"
                                    Maximum="100"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowOpacity, Mode=TwoWay}" />
                            <TextBlock Text="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowOpacity, StringFormat='{}{0}%'}"
                                       Width="46"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>

                <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource &#xE5CB;}"
                                               Content="主题"
                                               Description="设置悬浮窗主题">
                    <controls:SettingsExpanderItem.Footer>
                        <ComboBox SelectedIndex="{Binding ViewModel.Settings.FloatingWindowTheme, Mode=TwoWay}">
                            <ComboBoxItem>
                                <ci:IconText Glyph="&#xE5CB;" Text="跟随ClassIsland" />
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <ci:IconText Glyph="&#xF465;" Text="明亮" />
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <ci:IconText Glyph="&#xF44B;" Text="黑暗" />
                            </ComboBoxItem>
                        </ComboBox>
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>

                <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource &#xE20B;}"
                                               Content="阴影效果"
                                               Description="悬浮窗阴影效果">
                    <controls:SettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowShadowEnabled, Mode=TwoWay}" />
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>

                <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource &#xE7C3;}"
                                               Content="一直显示拖动把手"
                                               Description="即使未检测到触摸设备也显示拖动把手">
                    <controls:SettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowDragHandleAlwaysVisible, Mode=TwoWay}" />
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>
            </controls:SettingsExpander>

            <!-- 层级设置 -->
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xEA2F;}"
                                       Header="悬浮窗层级"
                                       Description="悬浮窗在屏幕上的层级。置底则会显示在所有窗口的后方，置顶则将显示在所有窗口的前方。"
                                       IsExpanded="False">
                <controls:SettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowLayer, Mode=TwoWay}">
                        <ComboBoxItem>
                            <ci:IconText Glyph="&#xE0CB;" Text="置底" />
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <ci:IconText Glyph="&#xE197;" Text="置顶" />
                        </ComboBoxItem>
                    </ComboBox>
                </controls:SettingsExpander.Footer>
                <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource &#xE125;}"
                                               Content="层级设置频率"
                                               Description="在什么时候重新设置悬浮窗层级。请注意，较高的频率可能会产生较高的性能占用并导致悬浮窗闪烁。">
                    <controls:SettingsExpanderItem.Footer>
                        <ComboBox
                            SelectedIndex="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowLayerRecheckMode, Mode=TwoWay}">
                            <ComboBoxItem>窗口层级变化时</ComboBoxItem>
                            <ComboBoxItem>前台窗口变化时</ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal"
                                            Classes="items-valign-center"
                                            Spacing="4">
                                    <TextBlock Text="每 50ms" />
                                    <ci:FluentIcon Glyph="&#xF431;"
                                                   FontSize="20"
                                                   Margin="0 -8"
                                                   Foreground="Orange" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal"
                                            Classes="items-valign-center"
                                            Spacing="4">
                                    <TextBlock Text="每 1ms" />
                                    <ci:FluentIcon Glyph="&#xF431;"
                                                   FontSize="20"
                                                   Margin="0 -8"
                                                   Foreground="OrangeRed" />
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>
            </controls:SettingsExpander>

            <!-- 规则集设置 -->
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xF17E;}"
                                       Header="规则集设置"
                                       Description="悬浮窗的显示/隐藏规则"
                                       IsExpanded="False">
                <StackPanel Margin="12,8,12,12" Spacing="12">
                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="悬浮窗规则集" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1"
                                              OnContent="启用" OffContent="禁用"
                                              IsChecked="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowHideOnRule, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock Text="启用后，当规则集满足时悬浮窗将自动隐藏"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12" />
                            <ruleset:RulesetControl Ruleset="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowHidingRules}"
                                                    ShowTitle="False"
                                                    IsEnabled="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowHideOnRule}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:SettingsExpander>

            <TextBlock Text="Programmer_Wang ©2026"
                       Foreground="Gray"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,40,0,0"
                       Opacity="0.7" />
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
