<ci:SettingsPageBase x:Class="SystemTools.FloatingWindowEditorSettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     xmlns:controls1="clr-namespace:SystemTools.Controls"
                     xmlns:ruleset="clr-namespace:ClassIsland.Core.Controls.Ruleset;assembly=ClassIsland.Core"
                     mc:Ignorable="d"
                     d:DesignHeight="450"
                     d:DesignWidth="800">
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">
            <Label FontSize="20"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                SystemTools
            </Label>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <ci:FluentIcon FontSize="56"
                               Glyph="&#xEA36;"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                <Label VerticalAlignment="Center" FontSize="28">设置 · 悬浮窗</Label>
            </StackPanel>

            <!-- 方案管理 + 显示开关（紧凑顶部栏） -->
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <ci:Field Grid.Column="0" Label="配置方案">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox ItemsSource="{Binding ViewModel.FloatingWindowProfileNames}"
                                  SelectedItem="{Binding ViewModel.SelectedFloatingWindowProfile, Mode=TwoWay}"
                                  SelectionChanged="OnFloatingWindowProfileSelectionChanged"
                                  MinWidth="150"
                                  MaxWidth="250" />
                        <Button Content="{ci:FluentIcon &#xE0B5;}"
                                ToolTip.Tip="切换"
                                Click="OnToggleFloatingWindowProfileClick"
                                Theme="{StaticResource TransparentButton}" />
                        <Button Content="{ci:FluentIcon &#xE00D;}"
                                ToolTip.Tip="新建"
                                Click="OnAddFloatingWindowProfileClick"
                                Theme="{StaticResource TransparentButton}" />
                        <Button Content="{ci:FluentIcon &#xE61D;}"
                                ToolTip.Tip="删除当前方案"
                                Click="OnRemoveCurrentProfileClick"
                                Theme="{StaticResource TransparentButton}" />
                    </StackPanel>
                </ci:Field>
                <ToggleSwitch Grid.Column="1"
                              OnContent="显示" OffContent="隐藏"
                              IsChecked="{Binding ViewModel.CurrentFloatingWindowProfile.ShowFloatingWindow, Mode=TwoWay}"
                              IsEnabled="{Binding ViewModel.HasFloatingTriggerEntries}"
                              Click="OnFloatingWindowConfigChanged" />
            </Grid>

            <!-- 按钮布局区域 -->
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xEA37;}"
                                       Header="悬浮窗按钮布局"
                                       Description="从下方组件库拖拽按钮到上方行中，或调整行内按钮顺序"
                                       IsExpanded="True"
                                       Margin="0,8,0,0">
                <StackPanel Margin="12,8,12,12" Spacing="8">
                    <!-- 行列表 -->
                    <ItemsControl ItemsSource="{Binding ViewModel.FloatingTriggerRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="8"
                                        Margin="0,0,0,6"
                                        DragDrop.AllowDrop="True"
                                        DragDrop.DragOver="OnFloatingTriggerRowDragOver"
                                        DragDrop.Drop="OnFloatingTriggerRowDrop">
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <!-- 行拖拽把手 -->
                                        <Border Grid.Row="0" Grid.Column="0"
                                                Padding="4,0"
                                                Margin="-4,0,4,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="⋮⋮"
                                                       FontSize="14"
                                                       Opacity="0.5"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <!-- 按钮列表 -->
                                        <Border Grid.Row="0" Grid.Column="1"
                                                MinHeight="44"
                                                CornerRadius="6"
                                                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                Padding="6"
                                                DragDrop.AllowDrop="True"
                                                DragDrop.DragOver="OnFloatingTriggerRowDragOver"
                                                DragDrop.Drop="OnFloatingTriggerRowDrop">
                                            <ItemsControl ItemsSource="{Binding Buttons}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center"
                                                                    Spacing="8" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                                CornerRadius="6"
                                                                Padding="8,4"
                                                                Margin="0,0,2,0"
                                                                DragDrop.AllowDrop="True"
                                                                DragDrop.DragOver="OnFloatingTriggerItemDragOver"
                                                                DragDrop.Drop="OnFloatingTriggerItemDrop">
                                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                                  ColumnSpacing="6">
                                                                <!-- 拖拽把手 -->
                                                                <Border Grid.Column="0"
                                                                        Tag="{Binding ButtonId}"
                                                                        Padding="4,2"
                                                                        CornerRadius="4"
                                                                        Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                                        PointerPressed="OnFloatingTriggerItemPointerPressed"
                                                                        PointerMoved="OnFloatingTriggerItemPointerMoved"
                                                                        PointerReleased="OnFloatingTriggerItemPointerReleased">
                                                                    <TextBlock Text="⋮"
                                                                               FontSize="12"
                                                                               Opacity="0.6"
                                                                               VerticalAlignment="Center"
                                                                               HorizontalAlignment="Center" />
                                                                </Border>
                                                                <!-- 图标+名称 -->
                                                                <StackPanel Grid.Column="1"
                                                                            Orientation="Horizontal"
                                                                            Spacing="4"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Icon}"
                                                                               FontSize="14" />
                                                                    <TextBlock Text="{Binding ButtonName}"
                                                                               FontSize="13"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <!-- 删除按钮 -->
                                                                <Button Grid.Column="2"
                                                                        Content="{ci:FluentIcon &#xE61D;}"
                                                                        FontSize="10"
                                                                        Padding="2,0"
                                                                        Foreground="IndianRed"
                                                                        Theme="{StaticResource TransparentButton}"
                                                                        Click="OnRemoveTriggerFromRowClick"
                                                                        Tag="{Binding ButtonId}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <!-- 行操作 + 规则集 -->
                                        <StackPanel Grid.Row="0" Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="2"
                                                    VerticalAlignment="Center"
                                                    Margin="4,0,0,0">
                                            <!-- 行规则集折叠按钮 -->
                                            <Button Content="{ci:FluentIcon &#xE9A8;}"
                                                    ToolTip.Tip="行规则集"
                                                    Click="OnToggleRowRulesetClick"
                                                    Theme="{StaticResource TransparentButton}" />
                                            <Button Content="{ci:FluentIcon &#xE00D;}"
                                                    ToolTip.Tip="在下方插入一行"
                                                    Click="OnInsertRowBelowClick"
                                                    Theme="{StaticResource TransparentButton}" />
                                            <Button Content="{ci:FluentIcon &#xE61D;}"
                                                    ToolTip.Tip="删除行"
                                                    Foreground="IndianRed"
                                                    Click="OnRemoveFloatingTriggerRowClick"
                                                    Theme="{StaticResource TransparentButton}" />
                                        </StackPanel>

                                        <!-- 行规则集展开区域 -->
                                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                IsVisible="{Binding IsRulesetExpanded}"
                                                Margin="24,6,0,0"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="6"
                                                Padding="10,8">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding RowIndex, StringFormat='第 {0} 行规则集'}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <ToggleSwitch Grid.Column="1"
                                                                  OnContent="显示" OffContent="隐藏"
                                                                  IsChecked="{Binding RowRuleset.IsVisible, Mode=TwoWay}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="启用规则集控制"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center" />
                                                    <ToggleSwitch Grid.Column="1"
                                                                  IsChecked="{Binding RowRuleset.RulesetEnabled, Mode=TwoWay}" />
                                                </Grid>
                                                <ruleset:RulesetControl Ruleset="{Binding RowRuleset.Ruleset}"
                                                                        ShowTitle="False"
                                                                        IsEnabled="{Binding RowRuleset.RulesetEnabled}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 可用按钮池（WrapPanel 自动换行） -->
                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,4,0,0"
                            DragDrop.AllowDrop="True"
                            DragDrop.DragOver="OnFloatingTriggerRowDragOver"
                            DragDrop.Drop="OnAvailablePoolDrop">
                        <StackPanel Spacing="8">
                            <TextBlock Text="组件库（拖拽到上方行中）"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="13" />
                            <ItemsControl ItemsSource="{Binding ViewModel.AvailableFloatingTriggerItems}"
                                          HorizontalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="8"
                                                Padding="10,8"
                                                Width="160"
                                                Margin="4"
                                                PointerPressed="OnFloatingTriggerItemPointerPressed"
                                                PointerMoved="OnFloatingTriggerItemPointerMoved"
                                                PointerReleased="OnFloatingTriggerItemPointerReleased"
                                                Tag="{Binding ButtonId}">
                                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                                <!-- 拖拽把手 -->
                                                <Border Grid.Column="0"
                                                        Padding="4,2"
                                                        CornerRadius="4"
                                                        Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="⋮"
                                                               FontSize="14"
                                                               Opacity="0.5"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Icon}"
                                                           FontSize="24"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            Spacing="1">
                                                    <TextBlock Text="{Binding ButtonName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="拖拽添加"
                                                               FontSize="11"
                                                               Opacity="0.6" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="暂无可用按钮"
                                       HorizontalAlignment="Center"
                                       Opacity="0.5"
                                       FontSize="12"
                                       IsVisible="{Binding !ViewModel.AvailableFloatingTriggerItems.Count}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:SettingsExpander>

            <!-- 外观设置 -->
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE51E;}"
                                       Header="外观设置"
                                       Description="设置悬浮窗外观"
                                       IsExpanded="False">

                <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource &#xE10B;}"
                                               Content="悬浮窗缩放"
                                               Description="调整悬浮窗缩放大小">
                    <controls:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Slider Width="160"
                                    Minimum="0.5"
                                    Maximum="2"
                                    TickFrequency="0.1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowScale, Mode=TwoWay}" />
                            <TextBlock
                                Text="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowScale, StringFormat='{}{0:F1}x'}"
                                Width="46"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>

                <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource &#xF17E;}"
                                               Content="图标大小"
                                               Description="调整悬浮窗内图标缩放">
                    <controls:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Slider Width="160"
                                    Minimum="15"
                                    Maximum="50"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowIconSize, Mode=TwoWay}" />
                            <TextBlock
                                Text="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowIconSize, StringFormat='{}{0}px'}"
                                Width="46"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>

                <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource &#xF17E;}"
                                               Content="文字大小"
                                               Description="调整悬浮窗内文字缩放">
                    <controls:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Slider Width="160"
                                    Minimum="8"
                                    Maximum="25"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowTextSize, Mode=TwoWay}" />
                            <TextBlock
                                Text="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowTextSize, StringFormat='{}{0}px'}"
                                Width="46"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>

                <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource &#xF045;}"
                                               Content="透明度"
                                               Description="调整悬浮窗透明度">
                    <controls:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Slider Width="160"
                                    Minimum="10"
                                    Maximum="100"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowOpacity, Mode=TwoWay}" />
                            <TextBlock Text="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowOpacity, StringFormat='{}{0}%'}"
                                       Width="46"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>

                <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource &#xEA37;}"
                                               Content="主题"
                                               Description="设置悬浮窗主题">
                    <controls:SettingsExpanderItem.Footer>
                        <ComboBox SelectedIndex="{Binding ViewModel.Settings.FloatingWindowTheme, Mode=TwoWay}">
                            <ComboBoxItem>
                                <ci:IconText Glyph="&#xE5CB;" Text="跟随ClassIsland" />
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <ci:IconText Glyph="&#xF465;" Text="明亮" />
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <ci:IconText Glyph="&#xF44B;" Text="黑暗" />
                            </ComboBoxItem>
                        </ComboBox>
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>

                <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource &#xE20B;}"
                                               Content="阴影效果"
                                               Description="悬浮窗阴影效果">
                    <controls:SettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowShadowEnabled, Mode=TwoWay}" />
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>

                <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource &#xE7C3;}"
                                               Content="一直显示拖动把手"
                                               Description="即使未检测到触摸设备也显示拖动把手">
                    <controls:SettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowDragHandleAlwaysVisible, Mode=TwoWay}" />
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>
            </controls:SettingsExpander>

            <!-- 层级设置 -->
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xEA2F;}"
                                       Header="悬浮窗层级"
                                       Description="悬浮窗在屏幕上的层级。置底则会显示在所有窗口的后方，置顶则将显示在所有窗口的前方。"
                                       IsExpanded="False">
                <controls:SettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowLayer, Mode=TwoWay}">
                        <ComboBoxItem>
                            <ci:IconText Glyph="&#xE0CB;" Text="置底" />
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <ci:IconText Glyph="&#xE197;" Text="置顶" />
                        </ComboBoxItem>
                    </ComboBox>
                </controls:SettingsExpander.Footer>
                <controls:SettingsExpanderItem IconSource="{ci:FluentIconSource &#xE125;}"
                                               Content="层级设置频率"
                                               Description="在什么时候重新设置悬浮窗层级。请注意，较高的频率可能会产生较高的性能占用并导致悬浮窗闪烁。">
                    <controls:SettingsExpanderItem.Footer>
                        <ComboBox
                            SelectedIndex="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowLayerRecheckMode, Mode=TwoWay}">
                            <ComboBoxItem>窗口层级变化时</ComboBoxItem>
                            <ComboBoxItem>前台窗口变化时</ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal"
                                            Classes="items-valign-center"
                                            Spacing="4">
                                    <TextBlock Text="每 50ms" />
                                    <ci:FluentIcon Glyph="&#xF431;"
                                                   FontSize="20"
                                                   Margin="0 -8"
                                                   Foreground="Orange" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal"
                                            Classes="items-valign-center"
                                            Spacing="4">
                                    <TextBlock Text="每 1ms" />
                                    <ci:FluentIcon Glyph="&#xF431;"
                                                   FontSize="20"
                                                   Margin="0 -8"
                                                   Foreground="OrangeRed" />
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>
                    </controls:SettingsExpanderItem.Footer>
                </controls:SettingsExpanderItem>
            </controls:SettingsExpander>

            <!-- 规则集设置 -->
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE9A8;}"
                                       Header="规则集设置"
                                       Description="悬浮窗和按钮的显示/隐藏规则（行规则集已移至每行右侧）"
                                       IsExpanded="False">
                <StackPanel Margin="12,8,12,12" Spacing="12">
                    <!-- 悬浮窗规则集 -->
                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="悬浮窗规则集" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1"
                                              OnContent="启用" OffContent="禁用"
                                              IsChecked="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowRulesetEnabled, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock Text="启用后，当规则集不满足时悬浮窗将自动隐藏"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12" />
                            <ruleset:RulesetControl Ruleset="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowRuleset}"
                                                    ShowTitle="False"
                                                    IsEnabled="{Binding ViewModel.CurrentFloatingWindowProfile.FloatingWindowRulesetEnabled}" />
                        </StackPanel>
                    </Border>

                    <!-- 按钮规则集 -->
                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="按钮规则集" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding ViewModel.FloatingTriggerButtonConfigs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="6"
                                                Padding="10,8"
                                                Margin="0,0,0,6">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ButtonName}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                    <ToggleSwitch Grid.Column="2"
                                                                  OnContent="显示" OffContent="隐藏"
                                                                  IsChecked="{Binding Config.IsVisible, Mode=TwoWay}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="启用规则集控制"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center" />
                                                    <ToggleSwitch Grid.Column="1"
                                                                  IsChecked="{Binding Config.RulesetEnabled, Mode=TwoWay}" />
                                                </Grid>
                                                <ruleset:RulesetControl Ruleset="{Binding Config.Ruleset}"
                                                                        ShowTitle="False"
                                                                        IsEnabled="{Binding Config.RulesetEnabled}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </controls:SettingsExpander>

            <TextBlock Text="Programmer_Wang ©2026"
                       Foreground="Gray"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,40,0,0"
                       Opacity="0.7" />
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
